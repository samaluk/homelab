# Komodo client configuration, supplied by Infisical through the process environment.
# Secret values belong in Infisical prod /homelab-admin, never in this file.
# @redactLogs=true
# ---

# Base URL of the Komodo instance.
# @required @sensitive=false @type=url
KOMODO_URL=

# API key for this machine's Komodo access.
# @required @sensitive @type=string(minLength=1)
KOMODO_API_KEY=

# Secret paired with KOMODO_API_KEY.
# @required @sensitive @type=string(minLength=1)
KOMODO_API_SECRET=
