{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "docker:pinDigests",
    ":disableRateLimiting",
    ":automergeBranch"
  ],
  "internalChecksFilter": "strict",
  "labels": [
    "dependencies"
  ],
  "packageRules": [
    {
      "description": "Sitebin has no versioned releases; update its commit tag and digest together in a reviewed PR until upstream publishes ordered release tags.",
      "matchPackageNames": [
        "ghcr.io/ittrail/sitebin.io"
      ],
      "enabled": false
    },
    {
      "matchUpdateTypes": [
        "digest",
        "minor",
        "patch"
      ],
      "automerge": true
    },
    {
      "description": "Major updates require review of breaking changes and migration steps.",
      "matchUpdateTypes": [
        "major"
      ],
      "automerge": false
    },
    {
      "description": "Use SemVer for Executor's numbered releases and exclude platform-specific image tags.",
      "matchPackageNames": [
        "ghcr.io/usefulsoftwareco/executor-selfhost"
      ],
      "versioning": "semver",
      "allowedVersions": "/^\\d+\\.\\d+\\.\\d+(?:-beta\\.\\d+)?$/"
    },
    {
      "description": "Executor can automatically update within the 2.0.0 beta series. Review the transition to another release series or channel.",
      "matchPackageNames": [
        "ghcr.io/usefulsoftwareco/executor-selfhost"
      ],
      "matchCurrentVersion": "/^2\\.0\\.0-beta\\.\\d+$/",
      "matchNewValue": "!/^2\\.0\\.0-beta\\.\\d+$/",
      "automerge": false
    },
    {
      "description": "Wait one day when release timestamps are available (Docker Hub); timestamp-less registries such as GHCR bypass this delay.",
      "matchDatasources": [
        "docker"
      ],
      "additionalBranchPrefix": "{{parentDir}}-",
      "minimumReleaseAge": "1 day",
      "minimumReleaseAgeBehaviour": "timestamp-optional"
    },
    {
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "ghcr.io/matheusvellone/actual-ical",
        "matheusvellone/actual-ical",
        "actualbudget/actual-server",
        "docker.io/actualbudget/actual-server",
        "mattyfaz/actualtap",
        "docker.io/mattyfaz/actualtap",
        "samaluk/fintual-api",
        "docker.io/samaluk/fintual-api"
      ],
      "minimumReleaseAge": "0 days"
    },
    {
      "matchFileNames": [
        "immich/compose.yaml"
      ],
      "matchPackageNames": [
        "docker.io/valkey/valkey",
        "ghcr.io/immich-app/postgres"
      ],
      "enabled": false
    },
    {
      "matchFileNames": [
        "infisical/compose.yaml"
      ],
      "matchPackageNames": [
        "postgres"
      ],
      "enabled": false
    },
    {
      "matchFileNames": [
        "miniflux/compose.yaml",
        "reactive-resume/compose.yaml",
        "slashdocs/compose.yaml"
      ],
      "matchPackageNames": [
        "postgres"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "enabled": false
    },
    {
      "matchFileNames": [
        "qbittorrent/compose.yaml"
      ],
      "matchPackageNames": [
        "linuxserver/qbittorrent"
      ],
      "matchUpdateTypes": [
        "major",
        "minor",
        "patch"
      ],
      "enabled": false
    },
    {
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "plexinc/pms-docker"
      ],
      "allowedVersions": "/^\\d+\\.\\d+\\.\\d+\\.\\d+-[a-f0-9]+$/",
      "versioning": "regex:^(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)\\.(?<build>\\d+)-[a-f0-9]+$"
    },
    {
      "matchFileNames": [
        "immich/compose.yaml"
      ],
      "matchPackageNames": [
        "ghcr.io/immich-app/immich-server",
        "ghcr.io/immich-app/immich-machine-learning"
      ],
      "groupName": "immich app images"
    }
  ]
}
